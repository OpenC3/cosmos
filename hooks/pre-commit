#!/usr/bin/env ruby
# Pre-commit hook to update Copyright year in modified files
# and add copyright headers to newly created files

require 'time'
require 'open3'
require 'shellwords'

# Skip when the staged diff is not the author's own work: merges, cherry-picks,
# reverts and rebases stage files that came from other commits, so touching
# their headers would pollute the result.
['MERGE_HEAD', 'CHERRY_PICK_HEAD', 'REVERT_HEAD', 'rebase-merge', 'rebase-apply'].each do |marker|
  path = `git rev-parse --git-path #{marker}`.strip
  exit 0 if !path.empty? && File.exist?(path)
end

# Get current year
current_year = Time.now.year

# Get list of staged files
staged_files = `git diff --cached --name-only --diff-filter=ACM`.split("\n")

# Get list of newly added files (subset of staged_files)
added_files = `git diff --cached --name-only --diff-filter=A`.split("\n")

INNER_COPYRIGHT = lambda do |year|
  <<~HEADER.chomp
    # Copyright #{year} OpenC3, Inc.
    # All Rights Reserved.
    #
    # This program is distributed in the hope that it will be useful,
    # but WITHOUT ANY WARRANTY; without even the implied warranty of
    # MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
    # See LICENSE.md for more details.
    #
    # This file may also be used under the terms of a commercial license
    # if purchased from OpenC3, Inc.
  HEADER
end

HASH_COMMENT_EXTENSIONS = %w[.rb .py .sh .rake .gemspec .yaml .yml].freeze
JS_COMMENT_EXTENSIONS = %w[.js .ts .mjs .cjs .jsx .tsx].freeze
HTML_COMMENT_EXTENSIONS = %w[.vue].freeze
SUPPORTED_EXTENSIONS = (HASH_COMMENT_EXTENSIONS + JS_COMMENT_EXTENSIONS + HTML_COMMENT_EXTENSIONS).freeze

def build_copyright_header(file, year)
  inner = INNER_COPYRIGHT.call(year)
  case File.extname(file).downcase
  when *HASH_COMMENT_EXTENSIONS
    "#{inner}\n\n"
  when *JS_COMMENT_EXTENSIONS
    "/*\n#{inner}\n*/\n\n"
  when *HTML_COMMENT_EXTENSIONS
    "<!--\n#{inner}\n-->\n\n"
  end
end

# New files are often copied from existing ones, which drags along the Ball
# Aerospace copyright. Return the content without its leading comment block if
# that block mentions Ball Aerospace, otherwise nil.
def strip_ball_header(file, content)
  block =
    case File.extname(file).downcase
    when *JS_COMMENT_EXTENSIONS
      content[/\A\s*\/\*.*?\*\/[ \t]*\n*/m]
    when *HTML_COMMENT_EXTENSIONS
      content[/\A\s*<!--.*?-->[ \t]*\n*/m]
    else
      content[/\A(?:[ \t]*#.*\n|[ \t]*\n)+/]
    end
  return nil unless block&.match?(/Ball Aerospace/i)

  content.delete_prefix(block)
end

# Return [new_content, message] if the header in content needs fixing, else nil.
def fix_header(file, content, added, year)
  new_content = content.dup
  message = nil

  # A new file must only carry the OpenC3 header, so replace a copied Ball one
  if added && (stripped = strip_ball_header(file, new_content))
    new_content = stripped
    message = "Replaced Ball Aerospace header in: #{file}"
  end

  # Check if file has an OpenC3 copyright header
  has_copyright = new_content.match?(/^[#\/\*\s]*Copyright\s+\d{4}\s+OpenC3,\s+Inc\./i) ||
                  new_content.match?(/^[#\/\*\s]*All changes Copyright\s+\d{4},\s+OpenC3,\s+Inc\./i)

  # If no copyright and file is newly added, prepend a header
  unless has_copyright
    if added && (header = build_copyright_header(file, year))
      new_content = header + new_content
      message = "Added copyright header to: #{file}"
    end
    return new_content == content ? nil : [new_content, message]
  end

  # Pattern 1: Single OpenC3 copyright header
  # Pattern 2: Dual copyright with Ball Aerospace + OpenC3 ("All changes ...")
  [
    /^([#\/\*\s]*Copyright\s+)(\d{4})(\s+OpenC3,\s+Inc\.)$/i,
    /^([#\/\*\s]*All changes Copyright\s+)(\d{4})(,\s+OpenC3,\s+Inc\.)$/i
  ].each do |regex|
    new_content.gsub!(regex) { "#{$1}#{year}#{$3}" }
  end

  return nil if new_content == content

  [new_content, message || "Updated copyright year in: #{file}"]
end

def utf8(data)
  data.force_encoding('UTF-8')
  data.valid_encoding? ? data : nil
end

# File mode recorded in the index (e.g. 100644, 100755, 120000 for a symlink)
def index_mode(file)
  `git ls-files -s -- #{Shellwords.escape(file)}`.split.first
end

# Write new content into the index only, leaving the working tree alone
def stage_content(file, content)
  mode = index_mode(file)
  hash, status = Open3.capture2('git', 'hash-object', '-w', '--stdin', stdin_data: content)
  return false unless status.success? && mode

  system('git', 'update-index', '--cacheinfo', "#{mode},#{hash.strip},#{file}")
end

# Track if any files were modified
files_modified = false

staged_files.each do |file|
  # Skip if file doesn't exist (deleted files)
  next unless File.exist?(file)

  # Only process files with specific extensions
  next unless SUPPORTED_EXTENSIONS.include?(File.extname(file).downcase)

  # Skip files in the hooks directory
  next if file.start_with?('hooks/')

  # Skip template files for plugin generation
  next if file.start_with?('openc3/templates/')

  # Skip vendored/third-party JS files
  next if file.start_with?('openc3-cosmos-init/plugins/packages/openc3-tool-base/public/js/')

  # Skip symlinks. Check both the index mode (120000) and the working tree,
  # since a staged symlink may be a regular file on disk or vice versa.
  next if index_mode(file) == '120000' || File.symlink?(file)

  added = added_files.include?(file)

  # Fix the staged (index) version so only staged content is committed.
  # Skip binary files or files with invalid encoding.
  staged = utf8(`git show :#{Shellwords.escape(file)}`)
  next unless staged

  if (result = fix_header(file, staged, added, current_year))
    next unless stage_content(file, result[0])

    files_modified = true
    puts result[1]
  end

  # Apply the same header fix to the working tree, which may hold unstaged edits
  worktree = utf8(File.binread(file))
  if worktree && (result = fix_header(file, worktree, added, current_year))
    File.write(file, result[0])
  end
end


if files_modified
  puts "\nCopyright headers updated to #{current_year}. Staged content was updated; unstaged edits are preserved."
end

# Always allow commit to proceed
exit 0
