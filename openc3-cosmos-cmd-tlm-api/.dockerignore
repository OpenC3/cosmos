Dockerfile
# Ignore the Gemfile.lock so it is generated during the container build
Gemfile.lock
.git
.gitignore
.claude/
.vscode/
**/node_modules
coverage/
spec/
test/
.bundle/
# Keep the directories but no contents
log/*
tmp/*
# Never bake secrets into the image (gitignore does not apply to the build context)
config/master.key
.env
.env.*
*.pem
*.key
