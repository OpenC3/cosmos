{
  "name": "playwright",
  "version": "1.0.0",
  "description": "OpenC3 integration testing",
  "scripts": {
    "coverage": "node --max-old-space-size=8192 --expose-gc generate-coverage.mjs",
    "test": "pnpm test:parallel --quiet && pnpm test:serial --quiet && pnpm coverage",
    "test:parallel": "playwright test ./tests/*.p.spec.ts ./tests/**/*.p.spec.ts --project=chromium",
    "test:serial": "playwright test ./tests/*.s.spec.ts ./tests/**/*.s.spec.ts --project=chromium --workers=1",
    "test:enterprise": "pnpm test:enterprise:parallel && pnpm test:enterprise:serial",
    "test:enterprise:parallel": "ENTERPRISE=1 playwright test ./tests/enterprise/*.p.spec.ts --project=enterprise",
    "test:enterprise:serial": "ENTERPRISE=1 playwright test ./tests/enterprise/*.s.spec.ts --project=enterprise --workers=1",
    "test:keycloak": "ENTERPRISE=1 playwright test ./tests/keycloak.setup.ts --workers=1",
    "clean": "rm -rf coverage coverage-raw test-results || (rmdir /s /q coverage & rmdir /s /q coverage-raw & rmdir /s /q test-results)",
    "format": "prettier -w ./",
    "lint": "eslint ."
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "date-fns": "4.4.0",
    "jszip": "^3.10.2",
    "monocart-coverage-reports": "^3.1.0",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lodash": "^4.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
